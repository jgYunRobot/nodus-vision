{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.nodus.local/vision/v1/config.schema.json",
  "title": "Nodus Vision provider configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "device_id",
    "component_id",
    "device",
    "calibration",
    "provider",
    "pilot",
    "recording"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "device_id": {"$ref": "#/$defs/bounded_string"},
    "component_id": {"$ref": "#/$defs/bounded_string"},
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter"],
      "properties": {
        "adapter": {"enum": ["fake", "intel_d435"]},
        "fake": {"$ref": "#/$defs/fake_device"},
        "intel_d435": {"$ref": "#/$defs/intel_d435_device"}
      },
      "allOf": [
        {
          "if": {"properties": {"adapter": {"const": "fake"}}},
          "then": {
            "required": ["fake"],
            "properties": {"intel_d435": false}
          }
        },
        {
          "if": {"properties": {"adapter": {"const": "intel_d435"}}},
          "then": {
            "required": ["intel_d435"],
            "properties": {"fake": false}
          }
        }
      ]
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calibration_id",
        "sensor_frame",
        "mount_frame",
        "mount_local_transform"
      ],
      "properties": {
        "calibration_id": {"$ref": "#/$defs/bounded_string"},
        "sensor_frame": {"$ref": "#/$defs/bounded_string"},
        "mount_frame": {"$ref": "#/$defs/bounded_string"},
        "mount_local_transform": {"$ref": "#/$defs/mount_local_transform"}
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bind_host",
        "port",
        "advertised_base_url",
        "max_connections",
        "max_stream_clients",
        "request_timeout_ms",
        "max_header_bytes",
        "max_body_bytes",
        "max_frame_age_ms"
      ],
      "properties": {
        "bind_host": {"$ref": "#/$defs/bounded_string"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "advertised_base_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^http://(?!(?:0\\.0\\.0\\.0|\\*)[:/])[^\\u0000-\\u001F\\u007F]+$"
        },
        "max_connections": {"type": "integer", "minimum": 1, "maximum": 1024},
        "max_stream_clients": {"type": "integer", "minimum": 1, "maximum": 1024},
        "request_timeout_ms": {"type": "integer", "minimum": 1000, "maximum": 60000},
        "max_header_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "max_body_bytes": {"type": "integer", "minimum": 1, "maximum": 10485760},
        "max_frame_age_ms": {"type": "integer", "minimum": 1, "maximum": 60000},
        "allowed_origins": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^http://(?!(?:0\\.0\\.0\\.0|\\*)[:/])[^/?#@\\u0000-\\u001F\\u007F]+:[0-9]+$"
          }
        }
      }
    },
    "pilot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "base_url",
        "clock_domain",
        "connect_timeout_ms",
        "request_timeout_ms",
        "max_response_bytes",
        "retry_initial_delay_ms",
        "retry_max_delay_ms",
        "shutdown_timeout_ms"
      ],
      "properties": {
        "enabled": {"type": "boolean"},
        "base_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^http://(?!(?:0\\.0\\.0\\.0|\\*)[:/])(?!(?:[^/]*@))[^?#]+$"
        },
        "clock_domain": {"const": "monotonic_same_host"},
        "connect_timeout_ms": {"type": "integer", "minimum": 1000, "maximum": 60000},
        "request_timeout_ms": {"type": "integer", "minimum": 1000, "maximum": 60000},
        "max_response_bytes": {"type": "integer", "minimum": 1, "maximum": 10485760},
        "retry_initial_delay_ms": {"type": "integer", "minimum": 1, "maximum": 60000},
        "retry_max_delay_ms": {"type": "integer", "minimum": 1, "maximum": 60000},
        "shutdown_timeout_ms": {"type": "integer", "minimum": 1000, "maximum": 60000}
      }
    },
    "recording": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "root", "queue_capacity_frames", "max_duration_ms", "minimum_free_bytes", "finalize_timeout_ms", "bit_rate_bps", "preset", "tune"],
      "properties": {
        "enabled": {"type": "boolean"},
        "root": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^/[^\\u0000-\\u001F\\u007F]*$"},
        "queue_capacity_frames": {"type": "integer", "minimum": 1, "maximum": 4096},
        "max_duration_ms": {"type": "integer", "minimum": 1, "maximum": 3600000},
        "minimum_free_bytes": {"type": "integer", "minimum": 1, "maximum": 1099511627776},
        "finalize_timeout_ms": {"type": "integer", "minimum": 1000, "maximum": 600000},
        "bit_rate_bps": {"type": "integer", "minimum": 1, "maximum": 100000000},
        "preset": {"const": "veryfast"},
        "tune": {"const": "zerolatency"}
      }
    }
  },
  "$defs": {
    "bounded_string": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "mount_local_transform": {
      "type": "object",
      "description": "Fixed camera-body pose in mount_frame coordinates. Translation is meters. Euler angles are radians and compose as R_A1(r1) * R_A2(r2) * R_A3(r3) for euler_type=A1A2A3, matching PA-CONTROL nodus_rm semantics.",
      "additionalProperties": false,
      "required": ["x", "y", "z", "r1", "r2", "r3", "euler_type"],
      "properties": {
        "x": {"type": "number", "minimum": -10, "maximum": 10, "description": "Translation along the mount-frame x axis in meters."},
        "y": {"type": "number", "minimum": -10, "maximum": 10, "description": "Translation along the mount-frame y axis in meters."},
        "z": {"type": "number", "minimum": -10, "maximum": 10, "description": "Translation along the mount-frame z axis in meters."},
        "r1": {"type": "number", "description": "First Euler rotation angle in radians."},
        "r2": {"type": "number", "description": "Second Euler rotation angle in radians."},
        "r3": {"type": "number", "description": "Third Euler rotation angle in radians."},
        "euler_type": {
          "enum": ["XYZ", "XZY", "YXZ", "YZX", "ZXY", "ZYX", "ZXZ", "ZYZ"],
          "description": "Axis sequence A1A2A3 for R_A1(r1) * R_A2(r2) * R_A3(r3)."
        }
      }
    },
    "fake_device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "fps", "start_frame_number", "pattern_seed"],
      "properties": {
        "width": {"type": "integer", "minimum": 1, "maximum": 4096},
        "height": {"type": "integer", "minimum": 1, "maximum": 4096},
        "fps": {"type": "integer", "minimum": 1, "maximum": 240},
        "start_frame_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "pattern_seed": {"type": "integer", "minimum": 0, "maximum": 255}
      }
    },
    "intel_d435_device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serial_number",
        "depth_width",
        "depth_height",
        "depth_fps",
        "color_width",
        "color_height",
        "color_fps",
        "enable_color",
        "depth_min_m",
        "depth_max_m"
      ],
      "properties": {
        "serial_number": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001F\\u007F]*$",
          "description": "Optional librealsense serial selector. Empty selects exactly one name-matching D435 and fails on ambiguity."
        },
        "depth_width": {"type": "integer", "minimum": 1, "maximum": 4096},
        "depth_height": {"type": "integer", "minimum": 1, "maximum": 4096},
        "depth_fps": {"type": "integer", "minimum": 1, "maximum": 240},
        "color_width": {"type": "integer", "minimum": 1, "maximum": 4096},
        "color_height": {"type": "integer", "minimum": 1, "maximum": 4096},
        "color_fps": {"type": "integer", "minimum": 1, "maximum": 240},
        "enable_color": {"type": "boolean"},
        "depth_min_m": {"type": "number", "minimum": 0},
        "depth_max_m": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
