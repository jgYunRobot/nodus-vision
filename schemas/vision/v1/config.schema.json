{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nodus Vision provider configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "device_id", "component_id", "device", "calibration", "provider"],
  "properties": {
    "schema_version": {"const": 1},
    "device_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "component_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "device": {"type": "object", "additionalProperties": false},
    "calibration": {"type": "object", "additionalProperties": false},
    "provider": {"type": "object", "additionalProperties": false}
  }
}
